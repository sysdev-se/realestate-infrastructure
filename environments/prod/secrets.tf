# JWT signing keys for realestate-api (HS256, so each must be >= 32 bytes; the app
# refuses to start otherwise). Generated by Terraform but never stored in state or
# shown in plans: the password is ephemeral and written through the write-only
# secret_data_wo argument.
#
# To rotate one: bump its entry in local.api_jwt_secret_versions. This replaces the
# secret version (the old one is destroyed) and invalidates every token signed with
# it. New Cloud Run instances pick it up; redeploy realestate-api to replace running ones.
locals {
  api_jwt_secret_versions = {
    ACCESS_TOKEN_SECRET  = 1
    REFRESH_TOKEN_SECRET = 1
  }

  api_jwt_secret_ids = {
    ACCESS_TOKEN_SECRET  = "realestate-api-access-token-secret"
    REFRESH_TOKEN_SECRET = "realestate-api-refresh-token-secret"
  }
}

ephemeral "random_password" "api_jwt" {
  for_each = local.api_jwt_secret_ids

  length  = 64
  special = false
}

resource "google_secret_manager_secret" "api_jwt" {
  for_each = local.api_jwt_secret_ids

  project   = module.project.project_id
  secret_id = each.value
  labels    = local.labels

  replication {
    user_managed {
      replicas {
        location = var.region
      }
    }
  }
}

resource "google_secret_manager_secret_version" "api_jwt" {
  for_each = local.api_jwt_secret_ids

  secret                 = google_secret_manager_secret.api_jwt[each.key].id
  secret_data_wo         = ephemeral.random_password.api_jwt[each.key].result
  secret_data_wo_version = local.api_jwt_secret_versions[each.key]
}
