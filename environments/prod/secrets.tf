# Secrets for realestate-api, exposed to it as env vars (map key = env var name).
# Generated by Terraform but never stored in state or shown in plans: each value is
# an ephemeral password written through the write-only secret_data_wo argument.
#
# - ACCESS_TOKEN_SECRET / REFRESH_TOKEN_SECRET: HS256 JWT signing keys (the app
#   requires >= 32 bytes each).
# - ADMIN_PASSWORD: password of the admin user the app seeds at startup. Read it with
#   `gcloud secrets versions access latest --secret realestate-api-admin-password`.
#   Alphanumeric only, so it pastes safely into JSON and shells.
#
# To rotate one: bump its `version`. This replaces the secret version (the old one is
# destroyed). New Cloud Run instances pick it up; redeploy realestate-api to replace
# running ones. Rotating a JWT key invalidates every token signed with it.
locals {
  api_secrets = {
    ACCESS_TOKEN_SECRET = {
      secret_id = "realestate-api-access-token-secret"
      length    = 64
      version   = 1
    }
    REFRESH_TOKEN_SECRET = {
      secret_id = "realestate-api-refresh-token-secret"
      length    = 64
      version   = 1
    }
    ADMIN_PASSWORD = {
      secret_id = "realestate-api-admin-password"
      length    = 32
      version   = 1
    }
  }
}

ephemeral "random_password" "api" {
  for_each = local.api_secrets

  length  = each.value.length
  special = false
}

resource "google_secret_manager_secret" "api" {
  for_each = local.api_secrets

  project   = module.project.project_id
  secret_id = each.value.secret_id
  labels    = local.labels

  replication {
    user_managed {
      replicas {
        location = var.region
      }
    }
  }
}

resource "google_secret_manager_secret_version" "api" {
  for_each = local.api_secrets

  secret                 = google_secret_manager_secret.api[each.key].id
  secret_data_wo         = ephemeral.random_password.api[each.key].result
  secret_data_wo_version = each.value.version
}

# Renamed from api_jwt (RE-11) when ADMIN_PASSWORD was added; keeps the existing
# JWT secrets instead of recreating them (which would log everyone out).
moved {
  from = google_secret_manager_secret.api_jwt
  to   = google_secret_manager_secret.api
}

moved {
  from = google_secret_manager_secret_version.api_jwt
  to   = google_secret_manager_secret_version.api
}
